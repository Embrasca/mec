# Conexão do DONO do banco Neon (usada só no servidor e pelas migrações).
# A aplicação troca para o papel restrito `mec_app` em cada transação.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Endereço do Neon Auth do mesmo projeto (não é segredo; vai para o navegador).
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth
